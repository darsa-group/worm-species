#!/usr/bin/env bash
# Genome array task: one verified cache transfer per physical node.
set -euo pipefail

ARTIFACT_ROOT=@@ARTIFACT_ROOT@@
CACHE_ROOT=@@CACHE_ROOT@@
CACHE_READY_MARKER=@@CACHE_READY_MARKER@@
CONDITION_CACHE_ENABLED=@@CONDITION_CACHE_ENABLED@@
CONDITION_CACHE_ROOT=@@CONDITION_CACHE_ROOT@@
CONDA_ENV=@@CONDA_ENV@@
CONDA_SH=@@CONDA_SH@@
COPY_CACHE_TO_TMP=@@COPY_CACHE_TO_TMP@@
DATA_ROOT=@@DATA_ROOT@@
METADATA_CSV=@@METADATA_CSV@@
PROJECT_ROOT=@@PROJECT_ROOT@@
RESOLVED_CONFIG_DIR=@@RESOLVED_CONFIG_DIR@@
RESULTS_ROOT=@@RESULTS_ROOT@@
RUN_INDEX_FILE=@@RUN_INDEX_FILE@@
RUN_OUTPUT_ROOT=@@RUN_OUTPUT_ROOT@@
RUN_SPECS_DIR=@@RUN_SPECS_DIR@@
SCRATCH_ROOT=@@SCRATCH_ROOT@@
TMP_RESERVE_GB=@@TMP_RESERVE_GB@@

: "${SLURM_ARRAY_TASK_ID:?SLURM_ARRAY_TASK_ID is required}"
: "${SLURM_JOB_ID:?SLURM_JOB_ID is required}"
RUN_ID=$(awk -F '\t' -v task_id="$SLURM_ARRAY_TASK_ID" \
    'NR > 1 && $1 == task_id {print $2}' "$RUN_INDEX_FILE")
RUN_SPEC_FILE="${RUN_SPECS_DIR}/${RUN_ID}.args"
RESOLVED_CONFIG="${RESOLVED_CONFIG_DIR}/${RUN_ID}.yaml"
[[ -n "$RUN_ID" && -f "$RUN_SPEC_FILE" && -f "$RESOLVED_CONFIG" ]] || {
    echo "Incomplete run artifacts for array index $SLURM_ARRAY_TASK_ID" >&2
    exit 1
}

if [[ -n "$CONDA_SH" ]]; then
    source "$CONDA_SH"
    conda activate "$CONDA_ENV"
fi

[[ -d "$CACHE_ROOT" && -f "$CACHE_READY_MARKER" ]] || {
    echo "Persistent source cache is not ready: $CACHE_ROOT" >&2
    exit 1
}

mkdir -p "$SCRATCH_ROOT"
NODE_CACHE="${SCRATCH_ROOT}/image_cache"
NODE_READY="${NODE_CACHE}/$(basename "$CACHE_READY_MARKER")"
NODE_SIGNATURE="${NODE_CACHE}/SOURCE_READY.signature"
CACHE_LOCK="${SCRATCH_ROOT}/CACHE_COPY.lock"
source_signature="$CACHE_ROOT|$(stat -c '%d:%i:%s:%Y' "$CACHE_READY_MARKER")"

(
    flock -x 200
    cached_signature=""
    if [[ -f "$NODE_SIGNATURE" ]]; then
        cached_signature=$(<"$NODE_SIGNATURE")
    fi
    if [[ ! -f "$NODE_READY" || "$cached_signature" != "$source_signature" ]]; then
        cache_bytes=$(du -sb "$CACHE_ROOT" | awk '{print $1}')
        available_bytes=$(df -PB1 "$SCRATCH_ROOT" | awk 'NR == 2 {print $4}')
        reserve_bytes=$((TMP_RESERVE_GB * 1024 * 1024 * 1024))
        [[ "$cache_bytes" =~ ^[0-9]+$ && "$available_bytes" =~ ^[0-9]+$ ]] || {
            echo "Could not determine source-cache size or node-local space" >&2
            exit 1
        }
        (( available_bytes >= cache_bytes + reserve_bytes )) || {
            echo "Insufficient node-local space for the shared cache" >&2
            exit 1
        }
        partial="${SCRATCH_ROOT}/.image_cache.partial.${SLURM_JOB_ID}.${SLURM_ARRAY_TASK_ID}"
        rm -rf -- "$partial"
        mkdir -p "$partial"
        rsync -a "$CACHE_ROOT/" "$partial/"
        [[ -f "${partial}/$(basename "$CACHE_READY_MARKER")" ]] || {
            echo "Transferred cache has no readiness marker" >&2
            exit 1
        }
        printf '%s\n' "$source_signature" > "${partial}/SOURCE_READY.signature"
        rm -rf -- "$NODE_CACHE"
        mv "$partial" "$NODE_CACHE"
        echo "Published node-local cache on $(hostname)"
    else
        echo "Reusing node-local cache on $(hostname)"
    fi
) 200>"$CACHE_LOCK"

CONDITION_CACHE_OVERRIDES=()
if [[ "$CONDITION_CACHE_ENABLED" == "true" ]]; then
    NODE_CONDITION_ROOT="${SCRATCH_ROOT}/condition_cache"
    RUNTIME_CONDITION_ROOT="$CONDITION_CACHE_ROOT"
    RUNTIME_CONDITION_STAGING_ROOT="$NODE_CONDITION_ROOT"
    CONDITION_SOURCE=$(python -m worm_species.cache condition-path \
        --config "$RESOLVED_CONFIG" \
        --condition-cache-dir "$CONDITION_CACHE_ROOT" \
        --if-cacheable)
    if [[ -n "$CONDITION_SOURCE" ]]; then
    [[ -d "$CONDITION_SOURCE" && -f "$CONDITION_SOURCE/CACHE_READY" ]] || {
        echo "Condition cache is not ready: $CONDITION_SOURCE" >&2
        exit 1
    }
    CONDITION_VERSION=$(basename "$(dirname "$CONDITION_SOURCE")")
    CONDITION_NAME=$(basename "$CONDITION_SOURCE")
    NODE_CONDITION="${NODE_CONDITION_ROOT}/${CONDITION_VERSION}/${CONDITION_NAME}"
    CONDITION_LOCK="${SCRATCH_ROOT}/CONDITION_CACHE_${CONDITION_NAME}.lock"
    CONDITION_SIGNATURE="${NODE_CONDITION}/SOURCE_READY.signature"
    condition_source_signature="$CONDITION_SOURCE|$(stat -c '%d:%i:%s:%Y' "$CONDITION_SOURCE/CACHE_READY")"
    (
        flock -x 201
        cached_condition_signature=""
        if [[ -f "$CONDITION_SIGNATURE" ]]; then
            cached_condition_signature=$(<"$CONDITION_SIGNATURE")
        fi
        if [[ ! -f "$NODE_CONDITION/CACHE_READY" || "$cached_condition_signature" != "$condition_source_signature" ]]; then
            condition_bytes=$(du -sb "$CONDITION_SOURCE" | awk '{print $1}')
            available_bytes=$(df -PB1 "$SCRATCH_ROOT" | awk 'NR == 2 {print $4}')
            reserve_bytes=$((TMP_RESERVE_GB * 1024 * 1024 * 1024))
            (( available_bytes >= condition_bytes + reserve_bytes )) || {
                echo "Insufficient node-local space for condition cache" >&2
                exit 1
            }
            partial="${NODE_CONDITION_ROOT}/.partial.${CONDITION_NAME}.${SLURM_JOB_ID}.${SLURM_ARRAY_TASK_ID}"
            rm -rf -- "$partial"
            mkdir -p "$partial"
            rsync -a "$CONDITION_SOURCE/" "$partial/"
            [[ -f "$partial/CACHE_READY" ]] || {
                echo "Transferred condition cache has no readiness marker" >&2
                exit 1
            }
            printf '%s\n' "$condition_source_signature" > "$partial/SOURCE_READY.signature"
            mkdir -p "$(dirname "$NODE_CONDITION")"
            rm -rf -- "$NODE_CONDITION"
            mv "$partial" "$NODE_CONDITION"
            echo "Published condition cache $CONDITION_NAME on $(hostname)"
        else
            echo "Reusing condition cache $CONDITION_NAME on $(hostname)"
        fi
    ) 201>"$CONDITION_LOCK"
    RUNTIME_CONDITION_ROOT="$NODE_CONDITION_ROOT"
    else
        echo "Training condition is not precomputed; cached test conditions will stage on demand"
    fi
    CONDITION_CACHE_OVERRIDES+=(
        "cache.condition_variants.root=$RUNTIME_CONDITION_ROOT"
        "cache.condition_variants.source_root=$CONDITION_CACHE_ROOT"
        "cache.condition_variants.staging_root=$RUNTIME_CONDITION_STAGING_ROOT"
    )
fi

JOB_TMP="${TMPDIR:-/tmp/${SLURM_JOB_ID}}"
RUN_SCRATCH_OUT="${JOB_TMP}/worm_species/outputs/${RUN_ID}"
RUN_BACK_OUT="${RESULTS_ROOT}/${RUN_ID}"
mkdir -p "$RUN_SCRATCH_OUT" "$RUN_BACK_OUT"
cp "$RUN_SPEC_FILE" "$RUN_SCRATCH_OUT/run_overrides.args"
copy_results_back() {
    local status=$?
    local copy_status=0
    trap - EXIT
    set +e
    printf '%s\n' "$status" > "${RUN_SCRATCH_OUT}/run_status.txt"
    rsync -a "$RUN_SCRATCH_OUT/" "$RUN_BACK_OUT/"
    copy_status=$?
    if (( copy_status != 0 && status == 0 )); then status=90; fi
    exit "$status"
}
trap copy_results_back EXIT

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export WANDB_NAME="$RUN_ID"
CACHE_PARENT=$(dirname "$NODE_CACHE")
status=0
srun @@TRAIN_COMMAND@@ --config "$RESOLVED_CONFIG" --single-run --override \
    data.root_dir="$DATA_ROOT" data.metadata_csv="$METADATA_CSV" \
    output.out_dir="$RUN_SCRATCH_OUT" sweep.enabled=false \
    colour_ablation.enabled=false matched_condition_training.enabled=false \
    wandb.enabled="${WANDB_ENABLED:-true}" \
    wandb.project="${WANDB_PROJECT:-worm-species-paper}" \
    wandb.entity="${WANDB_ENTITY:-}" wandb.mode="${WANDB_MODE:-online}" \
    wandb.group="${WANDB_RUN_GROUP:-paper}" \
    cache.enabled=true cache.cache_dir="$NODE_CACHE" cache.dir="$NODE_CACHE" \
    cache.root_dir="$NODE_CACHE" cache.root_dir_cache="$CACHE_PARENT" \
    "${CONDITION_CACHE_OVERRIDES[@]}" \
    split.predefined_split_dir="$PROJECT_ROOT" || status=$?
exit "$status"
