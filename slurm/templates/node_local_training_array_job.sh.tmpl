#!/usr/bin/env bash
# Canonical GHPC node-local baseline/hierarchy array task.
set -euo pipefail

ARTIFACT_ROOT=@@ARTIFACT_ROOT@@
CACHE_ROOT=@@CACHE_ROOT@@
CACHE_READY_MARKER=@@CACHE_READY_MARKER@@
CONDA_ENV=@@CONDA_ENV@@
CONDA_SH=@@CONDA_SH@@
COPY_CACHE_TO_TMP=@@COPY_CACHE_TO_TMP@@
DATA_ROOT=@@DATA_ROOT@@
METADATA_CSV=@@METADATA_CSV@@
PROJECT_ROOT=@@PROJECT_ROOT@@
RESOLVED_CONFIG_DIR=@@RESOLVED_CONFIG_DIR@@
RESULTS_ROOT=@@RESULTS_ROOT@@
RUN_INDEX_FILE=@@RUN_INDEX_FILE@@
RUN_OUTPUT_ROOT=@@RUN_OUTPUT_ROOT@@
RUN_SPECS_DIR=@@RUN_SPECS_DIR@@
SCRATCH_ROOT=@@SCRATCH_ROOT@@
TMP_RESERVE_GB=@@TMP_RESERVE_GB@@

: "${SLURM_ARRAY_TASK_ID:?SLURM_ARRAY_TASK_ID is required}"
RUN_ID=$(awk -F '\t' -v index="$SLURM_ARRAY_TASK_ID" 'NR > 1 && $1 == index {print $2}' "$RUN_INDEX_FILE")
[[ -n "$RUN_ID" ]] || { echo "No run spec for array index $SLURM_ARRAY_TASK_ID" >&2; exit 2; }
RUN_SPEC_FILE="${RUN_SPECS_DIR}/${RUN_ID}.args"
RESOLVED_CONFIG="${RESOLVED_CONFIG_DIR}/${RUN_ID}.yaml"
[[ -f "$RUN_SPEC_FILE" && -f "$RESOLVED_CONFIG" ]] || { echo "Incomplete run artifacts for $RUN_ID" >&2; exit 2; }

RUN_SCRATCH_OUT="${RUN_OUTPUT_ROOT}/${RUN_ID}"
RUN_BACK_OUT="${RESULTS_ROOT}/${RUN_ID}"
mkdir -p "$RUN_SCRATCH_OUT" "$RUN_BACK_OUT" "$CACHE_ROOT"

if [[ -n "$CONDA_SH" ]]; then
    source "$CONDA_SH"
    conda activate "$CONDA_ENV"
fi
cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

(
    flock -x 200
    if [[ ! -f "$CACHE_READY_MARKER" ]]; then
        python - "$RESOLVED_CONFIG" "$DATA_ROOT" "$CACHE_ROOT" <<'PY'
import sys
from src.cache import build_image_cache
from worm_species.data.metadata import prepare_metadata
from src.utils import load_config

cfg = load_config(sys.argv[1])
cfg["data"]["root_dir"] = sys.argv[2]
cfg["data"]["metadata_csv"] = f"{sys.argv[2]}/01_Segmented/global_metadata.csv"
cfg["data"]["image_col"] = "rel_path_seg"
cfg.setdefault("cache", {}).update(
    enabled=True, cache_dir=sys.argv[3], dir=sys.argv[3], root_dir=sys.argv[3]
)
cached = build_image_cache(cfg, prepare_metadata(cfg))
if int(cached["_cached_image_path"].notna().sum()) == 0:
    raise RuntimeError("Image cache build produced no cached images")
PY
        touch "$CACHE_READY_MARKER"
    fi
) 200>"${SCRATCH_ROOT}/IMAGE_CACHE.lock"

status=0
@@TRAIN_COMMAND@@ --config "$RESOLVED_CONFIG" --single-run --override \
    data.root_dir="$DATA_ROOT" \
    data.metadata_csv="$METADATA_CSV" \
    output.out_dir="$RUN_SCRATCH_OUT" \
    sweep.enabled=false \
    colour_ablation.enabled=false \
    matched_condition_training.enabled=false \
    cache.enabled=true \
    cache.cache_dir="$CACHE_ROOT" \
    cache.dir="$CACHE_ROOT" \
    cache.root_dir="$CACHE_ROOT" \
    cache.root_dir_cache="$CACHE_ROOT" || status=$?
printf '%s\n' "$status" > "${RUN_SCRATCH_OUT}/run_status.txt"
rsync -a "$RUN_SCRATCH_OUT/" "$RUN_BACK_OUT/"
exit "$status"
